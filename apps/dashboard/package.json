    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.0",
    "jsdom": "^26.0.0",
    "playwright": "1.62.1",
    "tsx": "^4.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
