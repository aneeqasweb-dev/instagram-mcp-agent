NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DASHBOARD_ORIGIN=http://localhost:5173
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2:1.5b
OLLAMA_FALLBACK_MODEL=qwen2:1.5b-instruct-q3_K_M
OLLAMA_TIMEOUT_MS=90000
MONGODB_URI=mongodb://127.0.0.1:27017/instagram_agent
MCP_DATABASE_ENABLED=true
AGENT_MAX_ITERATIONS=25
AGENT_TIMEOUT_MS=300000
HUMAN_REVIEW_CONFIDENCE=0.80
INSTAGRAM_ALLOWED_ORIGIN=https://www.instagram.com
INSTAGRAM_STORAGE_STATE_PATH=playwright/.auth/instagram.json
MCP_INSTAGRAM_ENABLED=false
PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/google-chrome
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_ERROR_SCREENSHOT_DIR=playwright/errors
# Local API bearer session. Generate a long random value; protected routes deny access when absent.
API_SESSION_TOKEN=
API_USER_ID=local-user
